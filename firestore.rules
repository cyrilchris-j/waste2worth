rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }

    function isRecycler() {
      return isSignedIn() && userRole() == 'RECYCLER';
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'ADMIN';
    }

    function isCollector() {
      return isSignedIn() && userRole() == 'COLLECTOR';
    }

    function isVerifiedRecycler() {
      return isRecycler() &&
        get(/databases/$(database)/documents/recyclerProfiles/$(uid())).data.verificationStatus == 'VERIFIED';
    }

    // ─────────────────────────────────────────────────────────────────────────
    // USERS
    // ─────────────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isAdmin());
      allow create: if isSignedIn() && uid() == userId;
      allow update: if (isSignedIn() && uid() == userId &&
                        !('role' in request.resource.data.diff(resource.data).affectedKeys())) ||
                       isAdmin();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // RECYCLER PROFILES
    // ─────────────────────────────────────────────────────────────────────────

    match /recyclerProfiles/{recyclerId} {
      allow read:   if isSignedIn() && (uid() == recyclerId || isAdmin());
      allow create: if isSignedIn() && uid() == recyclerId;
      allow update: if (isSignedIn() && uid() == recyclerId &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['verificationStatus', 'verifiedAt', 'verifiedBy'])) ||
                       isAdmin();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // COLLECTOR PROFILES
    // ─────────────────────────────────────────────────────────────────────────

    match /collectorProfiles/{collectorId} {
      allow read:   if isSignedIn() && (uid() == collectorId || isAdmin());
      allow create: if isSignedIn() && uid() == collectorId;
      allow update: if (isSignedIn() && uid() == collectorId) || isAdmin();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // LOTS
    // ─────────────────────────────────────────────────────────────────────────

    match /lots/{lotId} {
      allow read: if (isVerifiedRecycler() && resource.data.status in ['LISTED', 'MATCHED', 'ACCEPTED', 'PAID', 'HANDED_OVER', 'RECEIVED', 'PROCESSING', 'COMPLETED']) ||
                     (isCollector() && resource.data.collectorId == uid()) ||
                     isAdmin();
      allow create: if isCollector();
      allow update: if (isCollector() && resource.data.collectorId == uid()) ||
                       (isVerifiedRecycler() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'updatedAt', 'acceptedBy', 'assignedRecyclerId'])) ||
                       isAdmin();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // OFFERS
    // ─────────────────────────────────────────────────────────────────────────

    match /offers/{offerId} {
      allow read:   if isSignedIn() &&
                       (resource.data.recyclerId == uid() || resource.data.collectorId == uid() || isAdmin());
      allow create: if isVerifiedRecycler() && request.resource.data.recyclerId == uid();
      allow update: if (isVerifiedRecycler() && resource.data.recyclerId == uid()) ||
                       (isCollector() && resource.data.collectorId == uid()) ||
                       isAdmin();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // TRANSACTIONS
    // ─────────────────────────────────────────────────────────────────────────

    match /transactions/{docId} {
      allow read: if isSignedIn() &&
                     (resource.data.recyclerId == uid() ||
                      resource.data.collectorId == uid() ||
                      isAdmin());
      allow create: if isVerifiedRecycler() && request.resource.data.recyclerId == uid();
      allow update: if (isSignedIn() && resource.data.recyclerId == uid() &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['agreedPrice', 'collectorId', 'lotId', 'recyclerId', 'platformFee'])) ||
                       (isSignedIn() && resource.data.collectorId == uid()) ||
                       isAdmin();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PAYMENTS
    // ─────────────────────────────────────────────────────────────────────────

    match /payments/{paymentId} {
      allow read: if isSignedIn() &&
                     (resource.data.recyclerId == uid() ||
                      resource.data.collectorId == uid() ||
                      isAdmin());
      allow create: if isVerifiedRecycler() || isAdmin();
      allow update: if isAdmin() || (isVerifiedRecycler() && resource.data.recyclerId == uid());
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // HANDOVER RECORDS
    // ─────────────────────────────────────────────────────────────────────────

    match /handoverRecords/{handoverId} {
      allow read: if isSignedIn() &&
                     (resource.data.recyclerId == uid() ||
                      resource.data.collectorId == uid() ||
                      isAdmin());
      allow create: if isSignedIn() && (isCollector() || isVerifiedRecycler() || isAdmin());
      allow update: if isSignedIn() &&
                     (resource.data.recyclerId == uid() ||
                      resource.data.collectorId == uid() ||
                      isAdmin());
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PROCESSING REPORTS
    // ─────────────────────────────────────────────────────────────────────────

    match /processingReports/{reportId} {
      allow read: if isSignedIn() &&
                     (resource.data.recyclerId == uid() || isAdmin());
      allow create: if isVerifiedRecycler() && request.resource.data.recyclerId == uid();
      allow update: if (isVerifiedRecycler() && resource.data.recyclerId == uid() &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['recyclerId', 'transactionId', 'lotId'])) ||
                       isAdmin();
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // AUDIT LOGS — append-only
    // ─────────────────────────────────────────────────────────────────────────

    match /auditLogs/{logId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // PRICE REFERENCES & SAFETY GUIDES (Read-only catalog for verified users)
    // ─────────────────────────────────────────────────────────────────────────

    match /priceReferences/{refId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /safetyGuides/{guideId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
