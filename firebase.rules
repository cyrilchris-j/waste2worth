rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.role == 'ADMIN'; }
    match /auditLogs/{id} { allow read: if signedIn(); allow create: if signedIn(); allow update, delete: if false; }
    match /transactions/{id} { allow read, create, update: if signedIn(); }
    match /offers/{id} { allow read, create, update: if signedIn(); }
    match /{document=**} { allow read: if signedIn(); allow write: if admin(); }
  }
}
