rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role(value) { return signedIn() && request.auth.token.role == value; }
    function admin() { return role('ADMIN'); }
    function participant(data) { return admin() || (signedIn() && (data.collectorId == request.auth.uid || data.recyclerId == request.auth.uid)); }
    match /users/{userId} { allow read, update: if admin() || (signedIn() && request.auth.uid == userId); allow create: if signedIn() && request.auth.uid == userId; allow delete: if admin(); }
    match /collectorProfiles/{collectorId} { allow read: if admin() || (signedIn() && request.auth.uid == collectorId); allow create, update: if admin() || (role('COLLECTOR') && request.auth.uid == collectorId); allow delete: if admin(); }
    match /recyclerProfiles/{recyclerId} { allow read: if signedIn(); allow create, update: if admin() || (role('RECYCLER') && request.auth.uid == recyclerId); allow delete: if admin(); }
    match /lots/{lotId} { allow read: if admin() || (resource.data.status == 'LISTED' && signedIn()) || (signedIn() && resource.data.collectorId == request.auth.uid); allow create: if role('COLLECTOR') && request.resource.data.collectorId == request.auth.uid; allow update: if admin() || (role('COLLECTOR') && resource.data.collectorId == request.auth.uid); allow delete: if admin() || (role('COLLECTOR') && resource.data.collectorId == request.auth.uid); }
    match /offers/{offerId} { allow read: if participant(resource.data); allow create: if signedIn() && (request.resource.data.collectorId == request.auth.uid || request.resource.data.recyclerId == request.auth.uid); allow update: if participant(resource.data); allow delete: if admin(); }
    match /transactions/{transactionId} { allow read: if participant(resource.data); allow create: if participant(request.resource.data); allow update: if participant(resource.data); allow delete: if admin(); }
    match /payments/{paymentId} { allow read: if participant(resource.data); allow create: if participant(request.resource.data); allow update: if admin(); allow delete: if admin(); }
    match /handoverRecords/{handoverId} { allow read: if participant(resource.data); allow create: if participant(request.resource.data); allow update: if participant(resource.data); allow delete: if admin(); }
    match /processingReports/{processingReportId} { allow read: if participant(resource.data); allow create: if role('RECYCLER') && request.resource.data.recyclerId == request.auth.uid; allow update: if participant(resource.data); allow delete: if admin(); }
    match /auditLogs/{eventId} { allow read: if admin() || participant(resource.data); allow create: if signedIn() && request.resource.data.actorId == request.auth.uid && (admin() || participant(request.resource.data)); allow update, delete: if false; }
    match /priceReferences/{referenceId} { allow read: if signedIn(); allow write: if admin(); }
    match /safetyGuides/{guideId} { allow read: if signedIn(); allow write: if admin(); }
  }
}
